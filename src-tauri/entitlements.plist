<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Outbound network requests (Alchemy RPC, marketplace APIs) -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- macOS Keychain access (private key + API key storage) -->
  <key>keychain-access-groups</key>
  <array>
    <string>$(AppIdentifierPrefix)com.westron.app</string>
  </array>
</dict>
</plist>
