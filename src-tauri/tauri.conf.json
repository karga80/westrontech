{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Westron",
  "version": "0.2.0",
  "identifier": "com.westron.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Westron",
        "width": 1280,
        "height": 800,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Finance",
    "copyright": "© 2025 Westron",
    "shortDescription": "Native macOS portfolio tracker for Ethereum & NFTs",
    "longDescription": "Westron is a native macOS application for Ethereum investors and NFT traders. Portfolio tracking, NFT gallery, bulk trading, analytics/PnL, real-time alerts, and sniping — all with keys stored locally in macOS Keychain.",
    "macOS": {
      "entitlements": "./entitlements.plist",
      "minimumSystemVersion": "12.0",
      "signingIdentity": null,
      "providerShortName": null,
      "dmg": {
        "background": null,
        "windowSize": { "width": 540, "height": 380 }
      }
    }
  }
}
