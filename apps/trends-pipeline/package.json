    "image-hash": "^7.0.1",
    "ioredis": "^5.10.1",
    "node-telegram-bot-api": "^0.67.0",
    "p-limit": "^7.3.0",
    "p-retry": "^8.0.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "twitter-api-v2": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
